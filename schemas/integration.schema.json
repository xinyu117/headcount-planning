{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "systems",
    "dataFlows"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "systems": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "name",
          "protocol",
          "metadataStatus"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "metadataStatus": {
            "enum": [
              "CONFIRMED",
              "TENANT_VALIDATION_REQUIRED"
            ]
          }
        }
      }
    },
    "dataFlows": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "purpose",
          "fieldMappingStatus",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "fieldMappingStatus": {
            "enum": [
              "CONFIRMED",
              "TBD"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
