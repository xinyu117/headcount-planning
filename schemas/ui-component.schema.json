{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Component Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "description",
          "props",
          "events",
          "implementation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "FORM",
              "DATA_TABLE",
              "TOOLBAR",
              "ACTION_BAR",
              "TREE",
              "TIMELINE",
              "PAGINATION",
              "CUSTOM"
            ]
          },
          "description": {
            "type": "string"
          },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation": {
            "type": "object",
            "required": [
              "framework",
              "component"
            ],
            "properties": {
              "framework": {
                "type": "string"
              },
              "component": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
