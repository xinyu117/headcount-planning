{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "workflow",
    "states",
    "transitions",
    "assignmentRules"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "workflow": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "id",
        "name",
        "engine",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "engine": {
          "const": "Flowable"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "START",
              "TASK",
              "END"
            ]
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "assignmentRules": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "taskId",
          "assigneeRule"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "assigneeRule": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "USER",
                  "ROLE",
                  "DEPARTMENT_ROLE",
                  "INITIATOR_MANAGER",
                  "EXPRESSION"
                ]
              },
              "userId": {
                "type": "string"
              },
              "roleCode": {
                "type": "string"
              },
              "departmentId": {
                "type": "string"
              },
              "expression": {
                "type": "string"
              },
              "fallback": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
