      "authorization": "AUDIT_VIEW",
      "requestSchema": null,
      "responseSchema": "AuditLogPage"
    },
    {
      "id": "API-ACCESS-LOG-LIST",
      "method": "GET",
      "path": "/api/access-logs",
      "moduleId": "account",
      "description": "查询用户登录和 IP 日志。",
      "authorization": "ACCESS_LOG_VIEW",
      "requestSchema": null,
      "responseSchema": "AccessLogPage"
    }
  ]
}
