{
  "schemaVersion": "1.2",
  "project": {
    "id": "HEADCOUNT-PLANNING",
    "name": "DSCN 人力预算与编制计划管理系统",
    "description": "基于 SAP SuccessFactors 组织、人员、职位和职衔主数据，覆盖模板配置、部门季度/年度填报、编制计划管理员审核、招聘团队评估、历史查询和报表导出的 Headcount Planning 系统。业务依据为《功能设计方案》V2.1。",
    "architecture": "modular-monolith"
  },
  "technology": {
    "backend": "Java 21 + Spring Boot 3",
    "frontend": "Vue 3 + TypeScript + Element Plus",
    "database": "MySQL 8",
    "workflow": "Flowable",
    "authorization": "Spring Security + jCasbin"
  },
  "modules": [
    {
      "id": "plan",
      "name": "编制计划管理"
    },
    {
      "id": "organization",
      "name": "组织管理"
    },
    {
      "id": "person",
      "name": "人员管理"
    },
    {
      "id": "position",
      "name": "职务与职衔管理"
    },
    {
      "id": "account",
      "name": "账号与会话管理"
    },
    {
      "id": "security",
      "name": "权限与角色管理"
    }
  ],
  "documentRefs": {
    "workflow": "workflows/headcount-approval.json",
    "dataModel": "data-model/entities.json",
    "api": "api/api-spec.json",
    "ui": "ui/ui-index.json",
    "integration": "integration/successfactors.json",
    "uiPages": "ui/pages.json",
    "uiTransitions": "ui/transitions.json",
    "uiActions": "ui/actions.json",
    "uiComponents": "ui/components.json"
  }
}
