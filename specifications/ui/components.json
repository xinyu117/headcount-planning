      "description": "计划年度、组织、状态等查询条件。",
      "props": [
        {
          "name": "modelValue",
          "type": "object",
          "required": true
        }
      ],
      "events": [
        "search",
        "reset"
      ],
      "actionBindings": [
        {
          "event": "search",
          "actionId": "ACT-SEARCH-PLANS"
        }
      ],
      "implementation": {
        "framework": "Vue 3",
        "component": "PlanSearchForm.vue"
      }
    },
    {
      "id": "PLAN-ADVANCED-FILTERS",
      "name": "计划高级筛选",
      "category": "FORM",
      "description": "扩展筛选条件区域。",
      "props": [
        {
          "name": "modelValue",
          "type": "object",
          "required": true
        }
      ],
      "events": [
        "apply",
        "reset"
      ],
      "actionBindings": [
        {
          "event": "apply",
          "actionId": "ACT-SEARCH-PLANS"
        }
      ],
      "implementation": {
        "framework": "Vue 3",
        "component": "PlanAdvancedFilters.vue"
      }
    },
    {
      "id": "PLAN-LIST-TOOLBAR",
