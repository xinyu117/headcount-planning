{
  "schemaVersion": "1.2",
  "actions": [
    {
      "id": "ACT-CREATE-PLAN",
      "name": "创建计划",
      "type": "NAVIGATION",
      "transitionId": "NAV-PLAN-CREATE",
      "description": "打开新建计划页；首次保存时创建草稿。"
    },
    {
      "id": "ACT-OPEN-PLAN-NEW-TAB",
      "name": "新标签页打开计划",
      "type": "NAVIGATION",
      "transitionId": "NAV-PLAN-NEW-TAB"
    },
    {
      "id": "ACT-SELECT-ORG",
      "name": "选择组织",
      "type": "NAVIGATION",
      "transitionId": "NAV-ORG-PICKER"
    },
    {
      "id": "ACT-SELECT-ORG-NEW",
      "name": "新计划选择组织",
      "type": "NAVIGATION",
      "transitionId": "NAV-ORG-PICKER-NEW"
    },
    {
      "id": "ACT-VIEW-PERSON",
      "name": "查看人员",
      "type": "NAVIGATION",
      "transitionId": "NAV-PERSON-QUICK-VIEW"
    },
    {
      "id": "ACT-TOGGLE-ADVANCED-FILTERS",
      "name": "高级筛选",
      "type": "NAVIGATION",
      "transitionId": "NAV-ADVANCED-FILTERS"
    },
    {
      "id": "ACT-SEARCH-PLANS",
      "name": "查询计划",
      "type": "API",
      "apiId": "API-PLAN-LIST",
      "httpMethod": "GET",
      "requestMapping": {
        "queryParameters": {
          "filters": "form"
        }
      },
      "confirm": {
        "enabled": false
      },
      "success": {
        "behavior": "REFRESH_COMPONENT",
        "targetComponentId": "PLAN-DATA-TABLE"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "查询失败，请检查条件后重试。"
      }
    },
    {
      "id": "ACT-LOAD-PLAN",
      "name": "加载计划详情",
      "type": "API",
      "apiId": "API-PLAN-GET",
      "httpMethod": "GET",
      "requestMapping": {
        "pathParameters": {
          "id": "route.id"
        }
      },
      "success": {
        "behavior": "REFRESH_COMPONENT",
        "targetComponentId": "PLAN-BASIC-FORM"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "加载计划详情失败，请稍后重试。"
      }
    },
    {
      "id": "ACT-SAVE-PLAN",
      "name": "保存草稿",
      "type": "API",
      "apiId": "API-PLAN-CREATE",
      "httpMethod": "POST",
      "requestMapping": {
        "body": "event.plan"
      },
      "confirm": {
        "enabled": false
      },
      "success": {
        "behavior": "NAVIGATE",
        "targetPageId": "PLAN-DETAIL",
        "parameterMapping": {
          "id": "response.id"
        },
        "message": "保存成功。"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "保存失败，请检查输入内容。"
      }
    },
    {
      "id": "ACT-UPDATE-PLAN",
      "name": "更新计划草稿",
      "type": "API",
      "apiId": "API-PLAN-UPDATE",
      "httpMethod": "PUT",
      "requestMapping": {
        "pathParameters": {
          "id": "route.id"
        },
        "body": "event.plan"
      },
      "confirm": {
        "enabled": false
      },
      "success": {
        "behavior": "SHOW_MESSAGE",
        "message": "保存成功。"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "保存失败，请检查输入内容。"
      }
    },
    {
      "id": "ACT-LOAD-APPROVAL-TASKS",
      "name": "加载审批待办",
      "type": "API",
      "apiId": "API-PLAN-APPROVAL-TASKS",
      "httpMethod": "GET",
      "success": {
        "behavior": "REFRESH_COMPONENT",
        "targetComponentId": "PLAN-APPROVAL-TASK-TABLE"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "加载审批待办失败，请稍后重试。"
      }
    },
    {
      "id": "ACT-LOAD-PLAN-APPROVAL",
      "name": "加载计划审批详情",
      "type": "API",
      "apiId": "API-PLAN-GET",
      "httpMethod": "GET",
      "requestMapping": {
        "pathParameters": {
          "id": "route.id"
        }
      },
      "success": {
        "behavior": "REFRESH_COMPONENT",
        "targetComponentId": "PLAN-APPROVAL-SUMMARY"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "加载计划详情失败，请稍后重试。"
      }
    },
    {
      "id": "ACT-APPROVE-PLAN",
      "name": "批准计划",
      "type": "API",
      "apiId": "API-PLAN-APPROVE",
      "httpMethod": "POST",
      "requestMapping": {
        "pathParameters": {
          "id": "route.id"
        }
      },
      "confirm": {
        "enabled": true,
        "message": "确定批准该计划吗？"
      },
      "success": {
        "behavior": "NAVIGATE",
        "targetPageId": "PLAN-APPROVAL-WORKSPACE",
        "message": "计划已批准。"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "批准失败，请稍后重试。"
      }
    },
    {
      "id": "ACT-SUBMIT-PLAN",
      "name": "提交审批",
      "type": "API",
      "apiId": "API-PLAN-SUBMIT",
      "httpMethod": "POST",
      "requestMapping": {
        "pathParameters": {
          "id": "route.id"
        }
      },
      "confirm": {
        "enabled": true,
        "message": "确定提交该计划进行审批吗？"
      },
      "success": {
        "behavior": "NAVIGATE",
        "targetPageId": "PLAN-WORKSPACE",
        "message": "计划已提交。"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "提交失败，请稍后重试。"
      }
    },
    {
      "id": "ACT-REJECT-PLAN",
      "name": "驳回计划",
      "type": "API",
      "apiId": "API-PLAN-REJECT",
      "httpMethod": "POST",
      "requestMapping": {
        "pathParameters": {
          "id": "route.id"
        },
        "body": "event"
      },
      "confirm": {
        "enabled": true,
        "message": "确定驳回该计划吗？"
      },
      "success": {
        "behavior": "NAVIGATE",
        "targetPageId": "PLAN-APPROVAL-WORKSPACE",
        "message": "计划已驳回。"
      },
      "failure": {
        "behavior": "SHOW_MESSAGE",
        "message": "驳回失败，请稍后重试。"
      }
    }
  ]
}
