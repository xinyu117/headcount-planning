    {
      "id": "EXP-PLAN-RESUBMIT-001",
      "requirementIds": [
        "PLAN-004",
        "PLAN-003"
      ],
      "actorRole": "PLAN_APPLICANT",
      "apiId": "API-PLAN-SUBMIT",
      "planId": 5003,
      "workflowTransitionId": "T-RESUBMIT",
      "expected": {
        "fromStatus": "RETURNED",
        "toStatus": "IN_REVIEW",
        "approvalTaskCreated": true
      },
      "knownGap": "同一 API 同时承担首次提交和重提，文档未单独定义重提请求契约。"
    },
    {
      "id": "TC-PLAN-005-001",
